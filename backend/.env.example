OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=

# Models (any value that changes answers also rolls the cache namespace over)
# gpt-5-nano: picked by scripts/compare_models.py + Ragas (see README "Choosing the chat model")
CHAT_MODEL=gpt-5-nano
# Leave empty to use each family's cheapest setting automatically
# (gpt-6 / gpt-5.x -> none, gpt-5 -> minimal, o-series -> low, gpt-4o / 4.1 -> not sent)
CHAT_REASONING_EFFORT=
EMBEDDING_MODEL=text-embedding-3-small
MODERATION_MODEL=omni-moderation-latest

# Retrieval — one Pinecone namespace per translation; the question's language picks the namespace
EN_TRANSLATION=bsb
ZH_TRANSLATION=cuv
TOP_K=5
# Minimum cosine similarity for a verse to be used as context (text-embedding-3-small:
# off-topic English ≤ 0.38, on-topic ≥ 0.47; Chinese scores run ~0.05 higher)
SCORE_THRESHOLD=0.40
SCORE_THRESHOLD_ZH=0.45

# Cache — Redis is optional; when unreachable the service still answers, uncached
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_ENABLED=true
CACHE_RESPONSE_TTL_SECONDS=86400
CACHE_EMBEDDING_TTL_SECONDS=604800
SEMANTIC_CACHE_ENABLED=true
# paraphrases of the same question score 0.71–0.97 with text-embedding-3-small, different questions ≤ 0.76
SEMANTIC_CACHE_THRESHOLD=0.85

# Rate limiting on POST /api/query (Redis sliding window; fails open without Redis; 0 disables)
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_GLOBAL_PER_MINUTE=60
# Which X-Forwarded-For entry is the client: -1 behind nginx, -2 behind Google's L7 load balancer
CLIENT_IP_XFF_INDEX=-1
